SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/alon_demo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Argentina/Buenos_Aires
SPRING_DATASOURCE_USERNAME=alon
