SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/alon?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Argentina/Buenos_Aires
SPRING_DATASOURCE_USERNAME=alon
SPRING_DATASOURCE_PASSWORD=alon_local
# Solo desarrollo local. En producción usar perfil production y conexión protegida.
ALON_BOOTSTRAP_STORE_ID=1
ALON_IMAGES_DIRECTORY=./data/article-images
# Imagen de portada opcional; no limita los rubros de la tienda.
# ALON_SHOP_HERO_IMAGE=/shop-assets/portada-herramientas.png
# Para adoptar una instalación antigua completa, usar una sola vez sobre una copia:
# ALON_ADOPT_LEGACY_SCHEMA=true
# Las cuentas de prueba se crean solo con SPRING_PROFILES_ACTIVE=local.
